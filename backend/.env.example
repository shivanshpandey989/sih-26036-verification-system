# Copy this file to .env and fill in real values before running the backend.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ovs_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET="change-this-to-a-long-random-string-before-any-real-deployment"
JWT_EXPIRES_IN="8h"

# Public frontend URL (used to build the QR verification link)
FRONTEND_URL="http://localhost:5173"

# Certificate expiry alert window (days)
EXPIRY_ALERT_DAYS=30

# Default validity period of a certificate, in months
CERTIFICATE_VALIDITY_MONTHS=12
